# Copy to .env and fill in. Never commit real values. On Vercel, set the same names as env vars.

# The board manager chat (Manager button in the app bar). Server only; without a key the chat answers "needs NUXT_ANTHROPIC_API_KEY".
NUXT_ANTHROPIC_API_KEY=
# Optional: the model it uses. Default claude-sonnet-5-5.
NUXT_MANAGER_MODEL=

# Where the board keeps its rows. Empty or "reference": one SQLite file (NUXT_BOARD_DB), no other service. This is the default.
# "n8n-gateway": the optional n8n adapter, set up by the gateway lines below. Any other value stops the server with an error.
NUXT_BOARD_BACKEND=
# The name in the header and the browser tab. Default claimboard.
NUXT_PUBLIC_APP_NAME=
# Optional orchestrator features: the /orchestrator screen, the Claude connector sign-in (/oauth) and the ask_vera and
# vera_reply tools on /mcp. "true" turns them on. Off by default; they need a gateway that answers the ask ops.
NUXT_PUBLIC_FEATURE_ORCHESTRATOR=

# n8n-gateway only. Board data: "fixtures" (mock/*.json, writes go to a local stand-in) or "gateway" (gw.gov-board-read and gw.gov-board-write).
# Left empty, the board uses the gateway when NUXT_BOARD_READ_URL is set and fixtures otherwise.
NUXT_BOARD_SOURCE=
# Fixtures mode only: a JSON file that keeps card, step and note writes across restarts. Empty (the default) keeps them in memory.
# Suggested: .data/board.json (already gitignored). Gateway mode never reads or writes it.
# With it set, the browser page sends its edits to the server and shows the server's rows, not its own copy.
# To reset to the seed fixtures: stop the server, delete the file, start again.
NUXT_BOARD_FILE=
# Example: https://your-n8n.example/webhook/gov-board-read
NUXT_BOARD_READ_URL=
# The header credential for gw.gov-board-read (n8n credential "board read header"): the header's name and its value.
NUXT_BOARD_HEADER_NAME=X-Board-Read-Key
NUXT_BOARD_HEADER_VALUE=

# Board writes through gw.gov-board-write. Left empty in gateway mode, the board is read only.
NUXT_BOARD_WRITE_URL=
# The header credential for gw.gov-board-write (n8n credential "board write header"): the header's name and its value.
NUXT_BOARD_WRITE_HEADER_NAME=
NUXT_BOARD_WRITE_HEADER_VALUE=

# Header status: the latest production build and the open PR count. Leave blank to hide them.
# On Vercel mark all four Sensitive. The Vercel token and the GitHub token are read only; never paste values in chat.
NUXT_VERCEL_TOKEN=
NUXT_VERCEL_PROJECT_ID=
NUXT_VERCEL_TEAM_ID=
NUXT_GITHUB_TOKEN=

# Login. Only this GitHub login may use the board.
NUXT_ALLOWED_GITHUB_LOGIN=
# Optional: more logins that may use the board, comma-separated. NUXT_ALLOWED_GITHUB_LOGIN still counts.
NUXT_ALLOWED_LOGINS=
# The board owner: the person the board writes as. Required; the default is a placeholder.
NUXT_PUBLIC_BOARD_OWNER=
# The owner's display name in the UI and in notes. Default Owner.
NUXT_PUBLIC_BOARD_OWNER_NAME=
NUXT_PUBLIC_DEFAULT_RUNNER=
# The GitHub repo of this board, owner/name. Used for the PR links in Changelog and Help and the open PR count. Empty hides them.
NUXT_PUBLIC_REPO_SLUG=
# The agent that answers a message when the agent on a card cannot (agt-<name>). Default agt-orchestrator.
NUXT_PUBLIC_ORCHESTRATOR_AGENT_ID=
# What the UI calls the orchestrator ("Ask <name>"). Default Orchestrator.
NUXT_PUBLIC_ORCHESTRATOR_NAME=
# Tags of the orchestrator's inbox card and of its board thread cards. Defaults orchestrator-inbox and orchestrator-board.
# A deployment whose cards already carry other tags sets these to those tags.
NUXT_PUBLIC_ORCHESTRATOR_INBOX_TAG=
NUXT_PUBLIC_ORCHESTRATOR_BOARD_TAG=
# The agent the Registry pages ask about access and drift (agt-<name>), and what the UI calls it. Defaults agt-registrar and Registrar.
NUXT_PUBLIC_REGISTRAR_AGENT_ID=
NUXT_PUBLIC_REGISTRAR_NAME=
# Which dispatcher target runs each agent's steps. JSON: {"agt-my-laptop":"laptop","agt-my-cloud":"cloud","agt-my-actions":"actions"}.
# The dispatcher script (scripts/board-run.mjs) reads this same variable from its environment. Empty: no agent is dispatched.
NUXT_PUBLIC_AGENT_TARGETS=
# Avatar monogram and color per agent. JSON: {"agt-my-agent":{"mono":"MA","color":"#7C3AED"}}. Empty: initials from the agent's name.
NUXT_PUBLIC_AGENT_AVATARS=
# Report color slots, first project gets slot 1. JSON list of project ids: ["my-project","other-project"]. Empty: slots by first appearance.
NUXT_PUBLIC_PROJECT_COLORS=
# A notes-vault folder name whose personal note paths agents may not write into card notes. Empty turns the check off.
NUXT_PUBLIC_VAULT_FOLDER=
# Vault subfolders whose notes may never be named in card text. JSON list: ["Private-Notes"]. Empty: none.
NUXT_PUBLIC_VAULT_PERSONAL_FOLDERS=
# Agents that have no board:class access row and still read from the cache, comma-separated (agt-<name>). Empty: every agent gets the class rule.
NUXT_UNSCOPED_AGENTS=
# The form where the owner files a connector token's hash, shown on the consent page. Empty hides the link.
NUXT_BOARD_TOKEN_FORM_URL=
# At least 32 characters. Encrypts the session cookie.
NUXT_SESSION_PASSWORD=
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=

# Local only: set to 1 to enable /auth/dev under `pnpm dev` (signs in as NUXT_ALLOWED_GITHUB_LOGIN
# without GitHub). Ignored by production builds. Anyone on your Wi-Fi can use it under `pnpm dev --host`.
NUXT_DEV_LOGIN=

# Proposed ops gw.gov-board-write supports, comma-separated (update_task, message_agent, nudge, archive_task).
# Blank keeps them off in gateway mode..
# apply_rollup is the one the step store's drain calls: name it only once n8n has it.
NUXT_BOARD_LIVE_OPS=

# The orchestrator connector sign-in (OAuth for claude.ai). At least 32 characters; every connector grant is sealed
# with it, and changing it signs every connector account out. Generate without printing:
#   vercel env add NUXT_CONNECTOR_SEAL_KEY production < <(openssl rand -base64 48)
NUXT_CONNECTOR_SEAL_KEY=

# Registry data: "fixtures" (mock/registry/*.json, local requests allowed), "gateway" (gw.gov-registry-read, read only),
# or "file" (a read-only copy of the live tables from `node scripts/registry-pull.mjs`, no workflow runs; local only).
# Left empty, the Registry uses the gateway when NUXT_REGISTRY_READ_URL is set and fixtures otherwise.
NUXT_REGISTRY_SOURCE=
# Where "file" reads the copy. Default .data/registry.json.
NUXT_REGISTRY_FILE=
# Example: https://your-n8n.example/webhook/gov-registry-read
NUXT_REGISTRY_READ_URL=
# The header credential for gw.gov-registry-read (n8n credential "registry read header"): the header's name and its value.
NUXT_REGISTRY_HEADER_NAME=X-Registry-Read-Key
NUXT_REGISTRY_HEADER_VALUE=

# The owner's on/off/auto switch per agent (Settings > Agents). Local board only: it needs a writable folder.
NUXT_AGENT_SWITCHES_FILE=

# Path B step store. "postgres" answers every step and note write from Postgres (agent step ops, messages, the owner's card
# ops) and lays those rows over the n8n cards on every board read; card changes go back to gov_tasks through apply_rollup.
# Leave empty to keep every op on n8n. The URL is a Postgres connection string; keep it here, never in the repo.
NUXT_STEP_STORE=
NUXT_STEP_STORE_URL=
# Optional. A wss:// URL (with its secret path) of a WebSocket-to-Postgres proxy, for a plain Postgres instead of Neon. Empty keeps Neon.
NUXT_STEP_STORE_WS_URL=
